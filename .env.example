# Protean environment example
# Copy to .env and fill only the providers/features you actually use.

# Core provider selection

# Optional. If unset, Protean auto-detects from configured provider keys.
# Examples: openai, anthropic, gemini, doubao
PROTEAN_DEFAULT_PROVIDER=

# OpenAI
OPENAI_API_KEY=
# Code fallback if unset: gpt-5
OPENAI_MODEL=
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Target model context window in tokens. Drives the image budget for
# `protean generate`: more context → more screenshots attached. Common values:
#   200000  — standard chat tier (Claude 4 family, GPT-4o, Gemini 2.5)
#   400000  — long-context GPT-5 / GPT-5.1
#   1000000 — Claude Opus 1M context tier; long-context Gemini
# Defaults to 200000 if unset. CLI `--max-context` overrides this.
PROTEAN_MAX_CONTEXT=200000

# Gemini
GEMINI_API_KEY=
# Realtime daemon model override. If unset, Protean uses the realtime provider default.
PROTEAN_REALTIME_MODEL=
# Common realtime setup example:
# GEMINI_API_KEY=your-gemini-key
# PROTEAN_REALTIME_MODEL=gemini-3.1-flash-live-preview
GEMINI_MODEL=


# Doubao / Ark
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional absolute path overrides. Leave commented to use <project_root>/data.
# Setup asks for one data root and derives the skills and recordings paths.
# PROTEAN_DATA_DIR=<absolute-path>
# PROTEAN_SKILLS_DIR=<absolute-path>
# PROTEAN_RECORDINGS_DIR=<absolute-path>

# Computer Use Agent (CUA) — terminal MCP integration
# When enabled, the CUA gains a `run_terminal_command` tool backed by
# DesktopCommanderMCP (https://github.com/wonderwhy-er/DesktopCommanderMCP).
# Requires `npx` on PATH (Node.js).
# Accepts: 1/true/yes/on (enable) or 0/false/no/off (disable). Default: true.
PROTEAN_CUA_TERMINAL=true
# Optional override of the MCP launch command (whitespace-separated).
# Default: npx -y @wonderwhy-er/desktop-commander@latest
# Example for a local checkout:
#   PROTEAN_CUA_TERMINAL_CMD=node /path/to/DesktopCommanderMCP/dist/index.js
PROTEAN_CUA_TERMINAL_CMD=

# Speech transcription (recorder mic path).
# OpenAI-compatible /v1/audio/transcriptions endpoint. The recorder POSTs
# each VAD-segmented utterance via the openai SDK and reads the response
# as plain text. Leave blank to skip transcription (SPEECH events will
# still be written with audio_path/duration, just no transcript).
PROTEAN_ASR_URL=
# Model id passed to /v1/audio/transcriptions. Default: whisper-1.
PROTEAN_ASR_MODEL=
# API key. Required for OpenAI proper; self-hosted servers usually ignore
# it. Falls back to a placeholder when unset so the SDK doesn't error.
PROTEAN_ASR_API_KEY=