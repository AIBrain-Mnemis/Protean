{
  "name": "protean-electron-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "TRTC + Realtime LLM bridge for Protean.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-renderer-assets.cjs",
    "typecheck": "tsc --noEmit",
    "start": "electron dist/main.js",
    "postinstall": "node scripts/install-trtc-frameworks.cjs",
    "print-electron-path": "node scripts/print-electron-path.cjs",
    "smoke:presence": "node scripts/smoke-presence.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "electron": "^42.0.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "trtc-electron-sdk": "^12.7.706"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
